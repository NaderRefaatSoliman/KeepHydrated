    <!-- Health Guide Tour & Medical Advices -->
    <string name="guide_tour_title">Dr. Droppy</string>
    <string name="guide_dehydration_title">Dangers &amp; Bad Effects of Dehydration</string>
    <string name="dehydration_intro">Not drinking enough water triggers significant strain on human physiology:</string>
    <string name="dehydration_point1_title">1. Mild Dehydration (1–2% loss):</string>
    <string name="dehydration_point1_desc">Causes chronic fatigue, throbbing headaches, dry mouth, impaired concentration, and mental brain fog.</string>
    <string name="dehydration_point2_title">2. Moderate Dehydration (3–5% loss):</string>
    <string name="dehydration_point2_desc">Elevates resting heart rate, causes dizziness upon standing, dark amber urine, and severe muscle cramps during movement.</string>
    <string name="dehydration_point3_title">3. Chronic Low Intake Hazards:</string>
    <string name="dehydration_point3_desc">Significantly increases the clinical risk of painful kidney stones, recurrent urinary tract infections (UTIs), constipation, and premature skin aging.</string>

    <!-- Water Toxicity (Hyponatremia) Warning -->
    <string name="guide_toxicity_title">⚠️ Water Toxicity &amp; Hyponatremia Warning</string>
    <string name="toxicity_subtitle">Can you drink too much water? YES! Overhydration can be fatal.</string>
    <string name="toxicity_kidney_limit_title">The Kidney Excretion Limit:</string>
    <string name="toxicity_kidney_limit_desc">A healthy adult kidney can only filter and excrete approximately 800 to 1,000 ml (0.8 - 1.0 L) of water per hour. Never chug more than 1 liter in a single hour!</string>
    <string name="toxicity_safe_ceiling_title">Safe Daily Upper Limit:</string>
    <string name="toxicity_safe_ceiling_desc">Your personal safe maximum intake is %1$s ml per day. Exceeding this dilutes essential blood electrolytes.</string>
    <string name="toxicity_symptoms_title">Symptoms of Water Toxicity (Hyponatremia):</string>
    <string name="toxicity_symptoms_desc">• Early Warning: Persistent headache, nausea, bloating, muscle cramps, and excessive clear urination.\n• Severe / Critical: Confusion, drowsiness, disorientation, seizures, cerebral edema, and coma. (Requires urgent emergency hospital care).</string>

    <!-- Safe Limits Box in Guide -->
    <string name="guide_safe_limits_box_title">⚠️ Safe Maximum Intake Limits (Overhydration Warning)</string>
    <string name="guide_safe_daily_limit_title">Safe Daily Upper Limit: %1$s ml</string>
    <string name="guide_safe_daily_limit_desc">Do not exceed this total in a single day to prevent hyponatremia (water toxicity).</string>
    <string name="guide_safe_hourly_limit_title">Maximum Hourly Limit: %1$s ml / hour</string>
    <string name="guide_safe_hourly_limit_desc">Adult kidneys can only filter ~800 to 1,000 ml per hour. Never drink more than 1 liter in a single hour!</string>

